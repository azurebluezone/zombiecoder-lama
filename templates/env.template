# lama environment — read by server/server.mjs and scripts/lamactl.mjs.
# process.env wins over this file. Keep this file at mode 0600.

# ---- engine -----------------------------------------------------------------
LLAMA_BIN={{LLAMA_BIN}}
LLAMA_MODEL_CTX=4096
LLAMA_THREADS=4

LAMA_LLAMA_HOST=127.0.0.1
LAMA_LLAMA_PORT=9931
LAMA_LLAMA_ARGS=--jinja --no-webui --metrics

# Unix socket path. Always enabled; empty means the default /tmp/llama-<uid>/llama.sock.
# The socket is created 0660 inside a 0700 directory.
LAMA_UDS_SOCK=

# Engine-native TLS (llama.cpp --ssl-key-file/--ssl-cert-file).
# Generate with: node scripts/gen-cert.mjs   then fill both lines.
LAMA_SSL_KEY=
LAMA_SSL_CERT=

# Who owns the engine process. `user` means lama-engine.service supervises it and
# the admin/CLI only ask systemd to restart with the selected model; `none` means
# the process that calls `engine load` spawns the engine itself (no supervision).
LAMA_SERVICE_MODE=user

# ---- manager (standalone; the admin app is optional) ------------------------
LAMA_MGMT_HOST=127.0.0.1
LAMA_MGMT_PORT=9934
# Bearer token for /api/* and the /v1 proxy. Empty = no auth (loopback only).
LAMA_API_KEY=

# The admin app is optional. It uses its own port and is never required to run
# the engine or the manager. Leave the token empty unless you start it.
LAMA_ADMIN_HOST=127.0.0.1
LAMA_ADMIN_PORT=9933
LAMA_ADMIN_TOKEN=

# ---- status / polling --------------------------------------------------------
# A read-only status file (server/status.mjs) for browser or socket polling.
# HTML is off by default; JSON only. Set LAMA_STATUS_HTML=1 to serve the page.
LAMA_STATUS_HOST=127.0.0.1
LAMA_STATUS_PORT=9935
LAMA_STATUS_UDS=
LAMA_STATUS_TOKEN=
LAMA_STATUS_HTML=0

# ---- tools (read-only by default) -------------------------------------------
# An admin/API token is management access, not host access. Writing files and
# running shell commands stay off until these are explicitly set to 1.
LAMA_TOOLS_ALLOW_WRITE=0
LAMA_TOOLS_ALLOW_SHELL=0
LAMA_FETCH_PORTS=80,443

# ---- storage ----------------------------------------------------------------
LAMA_MODELS_DIR={{LAMA_DIR}}/models
LAMA_LOG_DIR={{LAMA_DIR}}/logs
LAMA_DATA_DIR={{LAMA_DIR}}/data
LAMA_DB={{LAMA_DIR}}/data/lama.db

# ---- optional ---------------------------------------------------------------
HF_TOKEN=
# Path to zombie-gateway's .env — enables the "map" badge and /api/map.
LAMA_GATEWAY_ENV=
